SecurityEvent
| where EventID == 4720
| where TargetUserName !contains "HealthMailbox"
| where TargetUserName !contains "SM_"
| where SubjectUserName !in~ ("SYSTEM", "MSOL_", "Sync_", "AAD_")
| where TargetUserName !endswith "$"
| where SubjectUserName != "SYSTEM"
| extend AccountCreator = SubjectUserName, NewAccount = TargetUserName
| project TimeGenerated, AccountCreator, NewAccount, Computer
| extend MITRE_Technique = "T1078", Severity = "High"
